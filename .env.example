# Copy this file to .env and fill in real secret values (do NOT commit .env)

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lens_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=lens.cache.invalidations

# Redis
REDIS_HOST=redis

# JWT
JWT_KEY=dev-super-secret-key-change-me-please
JWT_ISSUER=lens-app
JWT_AUDIENCE=lens-app-users

# Optional overrides
ASPNETCORE_ENVIRONMENT=Development
LENSAPI_BASEURL=http://lensapi:5126/
